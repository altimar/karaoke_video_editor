{
  "name": "karaoke-video-editor",
  "version": "1.0.0",
  "description": "Browser-based karaoke video editor: load mp3 + lyrics, tap syllable timings, preview with effects, export MP4.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "fflate": "^0.8.3",
    "mediabunny": "^1.52.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "esbuild": "^0.28.1",
    "jsdom": "^30.0.1",
    "onnx-proto": "^8.0.1",
    "onnxruntime-node": "^1.27.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
