# Normalize text files to LF in the repo (git checks out as-is on Windows
# unless `core.autocrlf` is set). Keeps diffs clean across platforms.
* text=auto eol=lf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp3 binary
*.mp4 binary
*.wav binary
*.kfn binary
*.zip binary
